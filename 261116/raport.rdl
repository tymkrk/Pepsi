<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Hourly distinct active users from k_stats, in US Eastern Time (New York), including daylight saving time. Based on SP_Report_Check_User_Activity.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="pepsico">
      <DataSourceReference>pepdev</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="UserActivity">
      <Query>
        <DataSourceName>pepsico</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@report_date">
            <Value>=Parameters!report_date.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.SP_Report_User_Activity</CommandText>
      </Query>
      <Fields>
        <Field Name="date_stat">
          <DataField>date_stat</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="hour_stat">
          <DataField>hour_stat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="count_stat">
          <DataField>count_stat</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="ReportTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="User activity statistics – " &amp; Format(First(Fields!date_stat.Value, "UserActivity"), "yyyy/MM/dd")</Value>
                    <Style>
                      <FontFamily>Calibri</FontFamily>
                      <FontSize>24pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#215E99</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0in</Top>
            <Height>0.48in</Height>
            <Width>9.266in</Width>
            <Style>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingTop>0pt</PaddingTop>
              <PaddingRight>0pt</PaddingRight>
              <PaddingBottom>0pt</PaddingBottom>
              <VerticalAlign>Middle</VerticalAlign>
            </Style>
            <Left>0in</Left>
          </Textbox>
          <Textbox Name="ReportSubtitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Logged in users per hour</Value>
                    <Style>
                      <FontFamily>Calibri</FontFamily>
                      <FontSize>20pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0.62in</Top>
            <Height>0.37in</Height>
            <Width>9.266in</Width>
            <Style>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingTop>0pt</PaddingTop>
              <PaddingRight>0pt</PaddingRight>
              <PaddingBottom>0pt</PaddingBottom>
              <VerticalAlign>Middle</VerticalAlign>
            </Style>
            <Left>0in</Left>
          </Textbox>
          <Textbox Name="TimeZoneNote">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>US Eastern Time (New York; EST/EDT)</Value>
                    <Style>
                      <FontFamily>Calibri</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>#666666</Color>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Right</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>5.99in</Top>
            <Height>0.22in</Height>
            <Width>9.266in</Width>
            <Style>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingTop>0pt</PaddingTop>
              <PaddingRight>0pt</PaddingRight>
              <PaddingBottom>0pt</PaddingBottom>
              <VerticalAlign>Middle</VerticalAlign>
            </Style>
            <Left>0in</Left>
          </Textbox>
          <Chart Name="UserActivityChart">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="UserActivityHour">
                    <GroupExpressions>
                      <GroupExpression>=Fields!hour_stat.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!hour_stat.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <Label>=Fields!hour_stat.Value</Label>
                </ChartMember>
              </ChartMembers>
            </ChartCategoryHierarchy>
            <ChartSeriesHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Label>Number of users</Label>
                </ChartMember>
              </ChartMembers>
            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="ActiveUsers">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!count_stat.Value)</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style>
                          <Border>
                            <Color>White</Color>
                          </Border>
                          <FontSize>9pt</FontSize>
                          <Color>#404040</Color>
                          <FontFamily>Aptos</FontFamily>
                        </Style>
                        <UseValueAsLabel>true</UseValueAsLabel>
                        <Visible>true</Visible>
                        <Position>Top</Position>
                      </ChartDataLabel>
                      <Style>
                        <Color>#156082</Color>
                      </Style>
                      <ChartMarker>
                        <Style />
                      </ChartMarker>
                      <DataElementOutput>Output</DataElementOutput>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Column</Type>
                  <Subtype>Plain</Subtype>
                  <Style>
                    <Color>#156082</Color>
                  </Style>
                  <ChartEmptyPoints>
                    <Style />
                    <ChartMarker>
                      <Style />
                    </ChartMarker>
                    <ChartDataLabel>
                      <Style />
                    </ChartDataLabel>
                  </ChartEmptyPoints>
                  <ValueAxisName>Primary</ValueAxisName>
                  <CategoryAxisName>Primary</CategoryAxisName>
                  <ChartSmartLabel>
                    <CalloutLineColor>Black</CalloutLineColor>
                    <MinMovingDistance>0pt</MinMovingDistance>
                    <Disabled>true</Disabled>
                  </ChartSmartLabel>
                  <CustomProperties>
                    <CustomProperty>
                      <Name>PointWidth</Name>
                      <Value>0.32</Value>
                    </CustomProperty>
                  </CustomProperties>
                </ChartSeries>
              </ChartSeriesCollection>
            </ChartData>
            <ChartAreas>
              <ChartArea Name="Default">
                <ChartCategoryAxes>
                  <ChartAxis Name="Primary">
                    <Style>
                      <Border>
                        <Color>#D9D9D9</Color>
                        <Style>Solid</Style>
                      </Border>
                      <FontSize>9pt</FontSize>
                      <Color>#595959</Color>
                      <FontFamily>Aptos</FontFamily>
                    </Style>
                    <ChartAxisTitle>
                      <Caption />
                      <Style>
                        <FontSize>9pt</FontSize>
                        <Color>#5c5c5c</Color>
                      </Style>
                    </ChartAxisTitle>
                    <Interval>1</Interval>
                    <ChartMajorGridLines>
                      <Enabled>False</Enabled>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                        </Border>
                      </Style>
                    </ChartMajorGridLines>
                    <ChartMinorGridLines>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                          <Style>Dotted</Style>
                        </Border>
                      </Style>
                      <Enabled>False</Enabled>
                    </ChartMinorGridLines>
                    <ChartMajorTickMarks>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                          <Style>None</Style>
                        </Border>
                      </Style>
                      <Enabled>False</Enabled>
                    </ChartMajorTickMarks>
                    <ChartMinorTickMarks>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                        </Border>
                      </Style>
                      <Length>0.5</Length>
                      <Enabled>False</Enabled>
                    </ChartMinorTickMarks>
                    <CrossAt>NaN</CrossAt>
                    <Minimum>NaN</Minimum>
                    <Maximum>NaN</Maximum>
                    <Angle>0</Angle>
                    <ChartAxisScaleBreak>
                      <Style />
                    </ChartAxisScaleBreak>
                    <IncludeZero>true</IncludeZero>
                  </ChartAxis>
                </ChartCategoryAxes>
                <ChartValueAxes>
                  <ChartAxis Name="Primary">
                    <Style>
                      <Border>
                        <Color>Gainsboro</Color>
                        <Style>None</Style>
                      </Border>
                      <FontSize>9pt</FontSize>
                      <Color>#595959</Color>
                      <Format>0</Format>
                      <FontFamily>Aptos</FontFamily>
                    </Style>
                    <ChartAxisTitle>
                      <Caption />
                      <Style>
                        <FontSize>9pt</FontSize>
                        <Color>#5c5c5c</Color>
                      </Style>
                    </ChartAxisTitle>
                    <ChartMajorGridLines>
                      <Style>
                        <Border>
                          <Color>#D9D9D9</Color>
                          <Style>Solid</Style>
                          <Width>0.75pt</Width>
                        </Border>
                      </Style>
                      <Enabled>True</Enabled>
                    </ChartMajorGridLines>
                    <ChartMinorGridLines>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                          <Style>Dotted</Style>
                        </Border>
                      </Style>
                      <Enabled>False</Enabled>
                    </ChartMinorGridLines>
                    <ChartMajorTickMarks>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                          <Style>None</Style>
                        </Border>
                      </Style>
                      <Enabled>False</Enabled>
                    </ChartMajorTickMarks>
                    <ChartMinorTickMarks>
                      <Style>
                        <Border>
                          <Color>Gainsboro</Color>
                        </Border>
                      </Style>
                      <Length>0.5</Length>
                      <Enabled>False</Enabled>
                    </ChartMinorTickMarks>
                    <CrossAt>NaN</CrossAt>
                    <Minimum>0</Minimum>
                    <Maximum>NaN</Maximum>
                    <ChartAxisScaleBreak>
                      <Style />
                    </ChartAxisScaleBreak>
                    <Interval>=IIF(Max(Fields!count_stat.Value, "UserActivity") &lt;= 10, 1, Math.Ceiling(Max(Fields!count_stat.Value, "UserActivity") / 10.0 / 10.0) * 10)</Interval>
                    <IncludeZero>true</IncludeZero>
                  </ChartAxis>
                </ChartValueAxes>
                <Style>
                  <BackgroundColor>#FFFFFF</BackgroundColor>
                  <BackgroundGradientType>None</BackgroundGradientType>
                </Style>
              </ChartArea>
            </ChartAreas>
            <Palette>Pacific</Palette>
            <ChartNoDataMessage Name="NoDataMessage">
              <Caption>No Data Available</Caption>
              <Style>
                <BackgroundGradientType>None</BackgroundGradientType>
                <FontWeight>Bold</FontWeight>
                <TextAlign>General</TextAlign>
                <VerticalAlign>Top</VerticalAlign>
              </Style>
            </ChartNoDataMessage>
            <DataSetName>UserActivity</DataSetName>
            <Top>1.135in</Top>
            <Left>0in</Left>
            <Height>3.875in</Height>
            <Width>9.266in</Width>
            <Style>
              <Border>
                <Color>#D9D9D9</Color>
                <Style>Solid</Style>
                <Width>0.75pt</Width>
              </Border>
              <BackgroundColor>White</BackgroundColor>
              <BackgroundGradientType>None</BackgroundGradientType>
            </Style>
            <ChartTitles>
              <ChartTitle Name="UsersChartTitle">
                <Caption>Number of users</Caption>
                <Style>
                  <FontFamily>Aptos</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <Color>#595959</Color>
                  <TextAlign>Center</TextAlign>
                </Style>
                <Position>TopCenter</Position>
              </ChartTitle>
            </ChartTitles>
          </Chart>
          <Image Name="PepsiCoBrandFooter">
            <Source>Embedded</Source>
            <Value>PepsiCoFooter</Value>
            <Sizing>Fit</Sizing>
            <Top>5.204in</Top>
            <Left>0in</Left>
            <Height>0.624in</Height>
            <Width>9.257in</Width>
            <Style />
          </Image>
        </ReportItems>
        <Height>6.22in</Height>
        <Style />
      </Body>
      <Width>9.266in</Width>
      <Page>
        <PageHeight>8.5in</PageHeight>
        <PageWidth>11in</PageWidth>
        <LeftMargin>1in</LeftMargin>
        <RightMargin>0.7in</RightMargin>
        <TopMargin>1in</TopMargin>
        <BottomMargin>1in</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <ReportParameters>
    <ReportParameter Name="report_date">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value>=Nothing</Value>
        </Values>
      </DefaultValue>
      <Prompt>Activity date (US Eastern Time; NULL = today)</Prompt>
    </ReportParameter>
  </ReportParameters>
  <Language>en-US</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <EmbeddedImages>
    <EmbeddedImage Name="PepsiCoFooter">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>
</Report>
